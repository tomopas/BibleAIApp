# Copy to deploy/.env and edit the values marked below.
# The Docker stack, host generators, and API all read this one file.
# Never commit deploy/.env or ship its secrets in the Flutter app.

# MongoDB. Host scripts connect through the published loopback port; the API
# container overrides this to mongodb://mongo:27017.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=bibleai
# Optional Docker-only override for a local MongoDB container. Leave unset
# when MONGO_URI points to MongoDB Atlas or another shared server.
# MONGO_URI_DOCKER=mongodb://mongo:27017

# On-demand Ollama generation. Off by default: the server serves the
# interpretations prepared by generator.py and needs no Ollama or GPU.
BIBLEAI_LIVE_GENERATION=0

# Extra origins allowed to call the API from a browser.
BIBLE_AI_CORS_ORIGINS=http://localhost,http://127.0.0.1

# RustFS / S3. Host scripts use 127.0.0.1; the API container overrides the
# endpoint to http://rustfs:9000. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUDIO_S3_ENDPOINT=http://127.0.0.1:9000
AUDIO_S3_BUCKET=bible-audio
AUDIO_S3_REGION=us-east-1
AUDIO_S3_ACCESS_KEY=bibleai-admin
AUDIO_S3_SECRET_KEY=replace-with-a-long-random-secret

# Public address of the stack (Nginx, port 80). Replace with the machine's LAN
# IP or the church domain; it must be reachable from phones.
AUDIO_PUBLIC_BASE_URL=http://192.168.1.10
