#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Python virtual environments
.venv/
venv/
**/venv/
**/.venv/
__pycache__/

# Runtime data: translation cache, databases, checkpoints, and generated audio.
# These are produced locally (see README) and must never be committed.
# NOTE: the app sources in lib/ and the bundled assets in assets/ are tracked
# on purpose - do not ignore those directories.
/data/
backend/data/
worker/data/
server/data/
/exports/
**/*.db
**/*.sqlite
**/*.sqlite3

# Secrets and local deployment configuration
deploy/.env
.env
.env.local
*.pem
*.key
*.keystore
*.jks

# Copilot CLI local history can contain secrets
.lh/
copilot-session-*.md
